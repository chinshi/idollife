  "story": [
    {
      "id": "first-audition",
      "title": "一个试镜机会",
      "major": true,
      "text": "经纪人推门进来：「有个小场子的试镜，后天。你敢不敢去？」",
      "requires": { "statsAtLeast": { "dance": 15 }, "flagsNot": ["ev:first-audition"] },
      "choices": [
        {
          "id": "go",
          "label": "去，反正也没什么可输的",
          "text": "你去了。台下只有五个人，但你跳完了整支舞。",
          "effects": { "stamina": -10, "axes": { "self": 8, "others": 4, "fit": 3 } },
          "setFlag": "first-audition"
        },
        {
          "id": "prepare",
          "label": "再练两天，准备充分再去",
          "text": "你多练了两天，动作更稳了，但也错过了这次机会。",
          "effects": { "stamina": -5, "stats": { "dance": 2 }, "axes": { "self": 3, "fit": 5 } },
          "setFlag": "first-audition"
        },
        {
          "id": "skip",
          "label": "算了，还没准备好",
          "text": "你说下次吧。经纪人没再说什么。",
          "effects": { "axes": { "self": -6, "others": -2 } },
          "setFlag": "first-audition"
        }
      ]
    },
    {
      "id": "fan-letter",
      "title": "第一封信",
      "text": "后台收到一封手写信，字迹很认真：「谢谢你上周那场演出。」",
      "requires": { "axesAtLeast": { "others": 45 }, "flagsNot": ["ev:fan-letter"] },
      "choices": [
        {
          "id": "reply",
          "label": "回一封",
          "text": "你写了回信。一周后，她又来了，还带了朋友。",
          "effects": { "axes": { "others": 6, "self": 3 } },
          "setFlag": "fan-letter"
        },
        {
          "id": "keep",
          "label": "收起来，好好保存",
          "text": "你把信夹进笔记本里，没跟任何人说。",
          "effects": { "axes": { "self": 5 } },
          "setFlag": "fan-letter"
        }
      ]
    },
    {
      "id": "burnout",
      "title": "撑不住了",
      "major": true,
      "text": "连着几天没睡够，你在排练室的地板上坐了很久。",
