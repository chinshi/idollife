          "setFlag": "manager-doubt"
        },
        {
          "id": "brave",
          "label": "我没事，再给我点时间",
          "text": "他点点头，把下一场演出的资料推给你。",
          "effects": { "axes": { "self": -3, "others": 5, "fit": 4 }, "stamina": -5 },
          "setFlag": "manager-doubt"
        }
      ]
