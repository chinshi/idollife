      "choices": [
        {
          "id": "rest",
          "label": "请两天假，好好睡一觉",
          "text": "你睡了一整天，醒来时天已经黑了。",
          "effects": { "stamina": 40, "axes": { "self": 4 } },
          "setFlag": "burnout"
        },
        {
          "id": "push",
          "label": "咬牙继续",
          "text": "你继续练，但动作开始变形。",
          "effects": { "stamina": -5, "stats": { "dance": 1 }, "axes": { "self": -5, "fit": 2 } },
          "setFlag": "burnout"
        }
      ]
    },
    {
      "id": "crowded-fans",
      "title": "有人举你的名字",
      "text": "前排有人举起了写着你的灯牌，你差点忘了下一句歌词。",
      "requires": { "fansAtLeast": { "stage": 50 }, "flagsNot": ["ev:crowded-fans"] },
      "choices": [
        {
          "id": "look",
          "label": "看过去，笑一下",
          "text": "她愣了一下，然后喊得更大声了。",
          "effects": { "axes": { "others": 6, "self": 2 }, "stamina": 3 },
          "setFlag": "crowded-fans"
        },
        {
          "id": "focus",
          "label": "专心唱完这首歌",
          "text": "你没有抬头，但把这首歌唱到了最好。",
          "effects": { "axes": { "fit": 6, "self": 4 }, "stats": { "vocal": 1 } },
          "setFlag": "crowded-fans"
        }
      ]
    },
    {
      "id": "manager-doubt",
      "title": "经纪人的犹豫",
      "text": "「你最近……还撑得住吗？」他把话说到一半又咽了回去。",
      "requires": { "axesBelow": { "fit": 34 }, "flagsNot": ["ev:manager-doubt"] },
      "choices": [
        {
          "id": "honest",
          "label": "说实话，我不太确定",
          "text": "他沉默了很久，说「那就慢一点」。",
